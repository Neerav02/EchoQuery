# ==============================================================================
# EchoQuery v2.0.1 — Production Environment Configuration Template
# Instructions: Copy to .env.production on the deployment host.
# NEVER commit .env.production or files with real secrets to version control.
# ==============================================================================

# --- Networking & Domain ---
DOMAIN_NAME=echoquery.yourdomain.com
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="EchoQuery Distributed Task Engine"

# --- Security & JWT (Phase 08 Validated) ---
# MUST be unique, >= 32 UTF-8 bytes, non-default.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MINIMUM_32_BYTES_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (Internal Docker Network) ---
POSTGRES_USER=echo_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD
POSTGRES_DB=echo_prod_db
DATABASE_URL=postgresql://echo_prod_user:REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD@db:5432/echo_prod_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Redis & Celery Backend (Password Authentication Enforced) ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/1

# --- RabbitMQ Message Broker & DLQ ---
RABBITMQ_DEFAULT_USER=echo_broker_admin
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_STRONG_RABBITMQ_PASSWORD
CELERY_BROKER_URL=amqp://echo_broker_admin:REPLACE_WITH_STRONG_RABBITMQ_PASSWORD@broker:5672//

# --- Silo / MinIO S3-Compatible Object Storage ---
MINIO_ROOT_USER=echo_storage_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_STORAGE_SECRET
AWS_ACCESS_KEY_ID=echo_storage_admin
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_STRONG_MINIO_STORAGE_SECRET
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=echo-bucket
AWS_REGION=us-east-1

# --- AI Speech Inference (Local Zero-Cost Offline Whisper) ---
AI_PRIMARY_PROVIDER=local_whisper
AI_FALLBACK_PROVIDER=mock
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# --- Demo & Registration Controls ---
ENABLE_DEMO_LOGIN=false

# --- CORS Allowed Origins ---
CORS_ALLOWED_ORIGINS=https://echoquery.yourdomain.com
API_URL=http://api:8000

